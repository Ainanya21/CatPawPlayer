<Window
    x:Class="CatPawPlayer.NativeWin.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
    Title="猫爪播放器 (Windows 11 Native WinUI 3 极速版)"
    Height="800" Width="1280"
    WindowStartupLocation="CenterScreen"
    Background="Transparent">

    <Grid Background="#F1F5F9">
        <wv2:WebView2 x:Name="MainWebView" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" DefaultBackgroundColor="Transparent"/>
    </Grid>
</Window>
