<Page
    x:Class="CatPawPlayer.WinUI.Pages.DetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <ProgressRing x:Name="LoadingRing" IsActive="True"
                      Width="48" Height="48"
                      HorizontalAlignment="Center" VerticalAlignment="Center"/>

        <ScrollViewer x:Name="ContentScroller" Visibility="Collapsed">
            <StackPanel Padding="24,16,24,32" Spacing="20">

                <!-- Back + Actions Bar -->
                <Grid>
                    <Button Click="BackBtn_Click" Style="{StaticResource SubtleButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE72B;" FontSize="14"/>
                            <TextBlock Text="返回"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="FavoriteBtn"
                            HorizontalAlignment="Right"
                            Click="FavoriteBtn_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon x:Name="FavoriteIcon" Glyph="&#xE734;" FontSize="14"/>
                            <TextBlock x:Name="FavoriteText" Text="加入收藏"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <InfoBar x:Name="StatusInfoBar" IsOpen="False" Severity="Informational"/>

                <!-- Hero Info Section -->
                <Grid ColumnSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Cover -->
                    <Border Grid.Column="0" CornerRadius="8" Height="270" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                        <Image x:Name="CoverImage" Stretch="UniformToFill"/>
                    </Border>

                    <!-- Metadata -->
                    <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Top">
                        <TextBlock x:Name="TitleText" Style="{StaticResource TitleTextBlockStyle}"
                                   TextWrapping="Wrap"/>

                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                            <Border x:Name="YearBadge" Background="{ThemeResource ControlFillColorDefaultBrush}"
                                    CornerRadius="4" Padding="8,2" Visibility="Collapsed">
                                <TextBlock x:Name="YearText" Style="{StaticResource CaptionTextBlockStyle}"/>
                            </Border>
                            <Border x:Name="AreaBadge" Background="{ThemeResource ControlFillColorDefaultBrush}"
                                    CornerRadius="4" Padding="8,2" Visibility="Collapsed">
                                <TextBlock x:Name="AreaText" Style="{StaticResource CaptionTextBlockStyle}"/>
                            </Border>
                            <Border x:Name="RateBadge"
                                    Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                                    CornerRadius="4" Padding="8,2" Visibility="Collapsed">
                                <TextBlock x:Name="RateText" Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                           FontWeight="Bold"/>
                            </Border>
                        </StackPanel>

                        <StackPanel x:Name="MetaPanel" Spacing="4"/>

                        <TextBlock x:Name="ContentText"
                                   Style="{StaticResource BodyTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   MaxLines="6"
                                   IsTextSelectionEnabled="True"/>
                    </StackPanel>
                </Grid>

                <MenuFlyoutSeparator/>

                <!-- Episode Sources & Player Options -->
                <StackPanel Spacing="12">
                    <Grid>
                        <TextBlock Text="选集播放" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center"/>
                        <ToggleSwitch x:Name="MpvSwitch"
                                      Header="使用 Yaozhi-MPV 极速播放"
                                      OnContent="开 (推荐)"
                                      OffContent="关 (内置网页播放)"
                                      HorizontalAlignment="Right"
                                      IsOn="True"
                                      Toggled="MpvSwitch_Toggled"/>
                    </Grid>

                    <!-- Stream Metadata Probe Card -->
                    <Border x:Name="StreamMetaCard"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="14,10"
                            Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE768;" FontSize="14" Foreground="{ThemeResource SystemAccentColor}"/>
                                <TextBlock Text="资源流真实元数据：" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Border Background="{ThemeResource SystemAccentColor}" CornerRadius="4" Padding="6,2">
                                    <TextBlock x:Name="MetaResText" Text="4K UHD" FontSize="11" FontWeight="Bold" Foreground="White"/>
                                </Border>
                                <Border Background="#22000000" CornerRadius="4" Padding="6,2">
                                    <TextBlock x:Name="MetaCodecText" Text="HEVC / H.265" FontSize="11" FontWeight="SemiBold"/>
                                </Border>
                                <Border Background="#22000000" CornerRadius="4" Padding="6,2">
                                    <TextBlock x:Name="MetaAudioText" Text="AAC" FontSize="11"/>
                                </Border>
                                <Border x:Name="MetaLatencyBadge" Background="#059669" CornerRadius="4" Padding="6,2" Visibility="Collapsed">
                                    <TextBlock x:Name="MetaLatencyText" Text="36ms" FontSize="11" FontWeight="SemiBold" Foreground="White"/>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Pivot x:Name="SourcePivot" Margin="0,-6,0,0"/>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
