<Page
    x:Class="CatPawPlayer.WinUI.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer Padding="24,16,24,32">
        <StackPanel Spacing="28" MaxWidth="800" HorizontalAlignment="Left">
            
            <TextBlock Text="设置" Style="{StaticResource TitleTextBlockStyle}"/>

            <!-- Section 1: 播放器引擎设置 (Yaozhi-MPV) -->
            <StackPanel Spacing="16">
                <TextBlock Text="播放内核设置" Style="{StaticResource SubtitleTextBlockStyle}"/>

                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        Padding="20" CornerRadius="8"
                        BorderThickness="1"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                    <StackPanel Spacing="14">
                        <Grid>
                            <StackPanel Spacing="4">
                                <TextBlock Text="优先使用 Yaozhi-MPV 极速硬件加速播放器" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                <TextBlock Text="支持 4K HDR、超分辨率插帧、动漫画质优化与多音轨字幕同步"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                            <ToggleSwitch x:Name="UseMpvSwitch"
                                          HorizontalAlignment="Right"
                                          Toggled="UseMpvSwitch_Toggled"/>
                        </Grid>

                        <StackPanel Spacing="6">
                            <TextBlock Text="MPV 执行程序路径 (mpv.exe)" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="MpvPathBox"
                                         Grid.Column="0"
                                         PlaceholderText="请选择或输入 mpv.exe 完整路径（未配置时默认使用内置原生播放器）"
                                         TextChanged="MpvPathBox_TextChanged"/>
                                <Button x:Name="BrowseMpvBtn"
                                        Grid.Column="1"
                                        Content="浏览..."
                                        Click="BrowseMpvBtn_Click"/>
                            </Grid>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock x:Name="MpvStatusText"
                                       Text="⚪ 未配置 MPV 播放器 (自动使用内置原生播放器)"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource CaptionTextBlockStyle}"/>
                            <Button x:Name="TestMpvBtn"
                                    Content="测试启动播放器"
                                    Click="TestMpvBtn_Click"
                                    Style="{StaticResource SubtleButtonStyle}"
                                    Margin="12,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <MenuFlyoutSeparator/>

            <!-- Section 2: 外观设置 -->
            <StackPanel Spacing="16">
                <TextBlock Text="外观设置" Style="{StaticResource SubtitleTextBlockStyle}"/>
                
                <StackPanel Spacing="8">
                    <TextBlock Text="应用主题" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                    <RadioButtons x:Name="ThemeRadioButtons" SelectionChanged="ThemeRadioButtons_SelectionChanged">
                        <RadioButton Content="浅色模式 (Light)" Tag="Light"/>
                        <RadioButton Content="深色模式 (Dark)" Tag="Dark"/>
                        <RadioButton Content="跟随系统 (System)" Tag="Default"/>
                    </RadioButtons>
                </StackPanel>

                <StackPanel Spacing="10" Margin="0,8,0,0">
                    <TextBlock Text="预设主题强调色" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button Width="36" Height="36" CornerRadius="18" Background="#0078D4" Tag="#0078D4"
                                Click="AccentColorBtn_Click" ToolTipService.ToolTip="经典蓝" Padding="0" BorderThickness="2" BorderBrush="#80FFFFFF"/>
                        <Button Width="36" Height="36" CornerRadius="18" Background="#6366F1" Tag="#6366F1"
                                Click="AccentColorBtn_Click" ToolTipService.ToolTip="猫爪紫" Padding="0" BorderThickness="2" BorderBrush="#80FFFFFF"/>
                        <Button Width="36" Height="36" CornerRadius="18" Background="#10B981" Tag="#10B981"
                                Click="AccentColorBtn_Click" ToolTipService.ToolTip="翡翠绿" Padding="0" BorderThickness="2" BorderBrush="#80FFFFFF"/>
                        <Button Width="36" Height="36" CornerRadius="18" Background="#F59E0B" Tag="#F59E0B"
                                Click="AccentColorBtn_Click" ToolTipService.ToolTip="琥珀金" Padding="0" BorderThickness="2" BorderBrush="#80FFFFFF"/>
                        <Button Width="36" Height="36" CornerRadius="18" Background="#EF4444" Tag="#EF4444"
                                Click="AccentColorBtn_Click" ToolTipService.ToolTip="珊瑚红" Padding="0" BorderThickness="2" BorderBrush="#80FFFFFF"/>
                        <Button Width="36" Height="36" CornerRadius="18" Background="#EC4899" Tag="#EC4899"
                                Click="AccentColorBtn_Click" ToolTipService.ToolTip="蔷薇粉" Padding="0" BorderThickness="2" BorderBrush="#80FFFFFF"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Spacing="10" Margin="0,8,0,0">
                    <TextBlock Text="自定义强调色" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                    <ColorPicker x:Name="AccentColorPicker" IsColorSpectrumVisible="True"
                                 IsColorChannelTextInputVisible="False"
                                 ColorChanged="AccentColorPicker_ColorChanged"/>
                </StackPanel>
            </StackPanel>

            <MenuFlyoutSeparator/>

            <!-- Section 3: 网盘配置 -->
            <StackPanel Spacing="16">
                <Grid>
                    <TextBlock Text="网盘授权与 Cookie" Style="{StaticResource SubtitleTextBlockStyle}"/>
                    <Button Content="🖥️ 在软件内打开配置中心 (推荐扫码授权)"
                            Click="OpenInAppConfigCenter_Click"
                            Style="{StaticResource AccentButtonStyle}"
                            HorizontalAlignment="Right"/>
                </Grid>
                
                <Expander Header="Quark (夸克网盘)" HorizontalAlignment="Stretch">
                    <StackPanel Spacing="12" Padding="16">
                        <TextBox x:Name="QuarkCookieBox" Header="夸克 Cookie" PlaceholderText="输入夸克网盘 Cookie..."/>
                        <Button Content="保存配置" Click="SaveQuark_Click" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Right"/>
                    </StackPanel>
                </Expander>

                <Expander Header="Baidu (百度网盘)" HorizontalAlignment="Stretch">
                    <StackPanel Spacing="12" Padding="16">
                        <TextBox x:Name="BaiduCookieBox" Header="百度网盘 Cookie" PlaceholderText="输入百度网盘 Cookie..."/>
                        <Button Content="保存配置" Click="SaveBaidu_Click" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Right"/>
                    </StackPanel>
                </Expander>

                <Expander Header="115 网盘" HorizontalAlignment="Stretch">
                    <StackPanel Spacing="12" Padding="16">
                        <TextBox x:Name="Cookie115Box" Header="115 Cookie" PlaceholderText="输入 115 网盘 Cookie..."/>
                        <Button Content="保存配置" Click="Save115_Click" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Right"/>
                    </StackPanel>
                </Expander>
            </StackPanel>

            <MenuFlyoutSeparator/>

            <!-- Section 4: 关于 -->
            <StackPanel Spacing="16">
                <TextBlock Text="关于播放器" Style="{StaticResource SubtitleTextBlockStyle}"/>
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" Padding="20" CornerRadius="8" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                    <StackPanel Spacing="6">
                        <TextBlock Text="CatPawPlayer 猫爪播放器" FontWeight="Bold" FontSize="16"/>
                        <TextBlock x:Name="VersionTextBlock" Text="版本 1.0.1 正式版 (WinUI 3 原生版)" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Text="基于 Windows App SDK / WinUI 3、Yaozhi-MPV 渲染引擎与 Node.js 爬虫引擎原生构建。" Margin="0,8,0,0" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </Border>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>
