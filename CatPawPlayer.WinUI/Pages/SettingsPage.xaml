<Page
    x:Class="CatPawPlayer.WinUI.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer Padding="24,16,24,32">
        <StackPanel Spacing="28" MaxWidth="800" HorizontalAlignment="Left">
            
            <TextBlock Text="设置" Style="{StaticResource TitleTextBlockStyle}"/>

            <!-- Section 1: 播放器引擎设置 (Yaozhi-MPV) -->
            <StackPanel Spacing="16">
                <TextBlock Text="播放内核设置" Style="{StaticResource SubtitleTextBlockStyle}"/>

                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        Padding="20" CornerRadius="8"
                        BorderThickness="1"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                    <StackPanel Spacing="14">
                        <Grid>
                            <StackPanel Spacing="4">
                                <TextBlock Text="优先使用 Yaozhi-MPV 极速硬件加速播放器" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                <TextBlock Text="支持 4K HDR、超分辨率插帧、动漫画质优化与多音轨字幕同步"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                            <ToggleSwitch x:Name="UseMpvSwitch"
                                          HorizontalAlignment="Right"
                                          Toggled="UseMpvSwitch_Toggled"/>
                        </Grid>

                        <StackPanel Spacing="6">
                            <TextBlock Text="MPV 执行程序路径 (mpv.exe)" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="MpvPathBox"
                                         Grid.Column="0"
                                         PlaceholderText="请选择或输入 mpv.exe 完整路径（未配置时默认使用内置原生播放器）"
                                         TextChanged="MpvPathBox_TextChanged"/>
                                <Button x:Name="BrowseMpvBtn"
                                        Grid.Column="1"
                                        Content="浏览..."
                                        Click="BrowseMpvBtn_Click"/>
                            </Grid>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock x:Name="MpvStatusText"
                                       Text="⚪ 未配置 MPV 播放器 (自动使用内置原生播放器)"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource CaptionTextBlockStyle}"/>
                            <Button x:Name="TestMpvBtn"
                                    Content="测试启动播放器"
                                    Click="TestMpvBtn_Click"
                                    Style="{StaticResource SubtleButtonStyle}"
                                    Margin="12,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <MenuFlyoutSeparator/>

            <!-- Section 2: 外观设置 -->
            <StackPanel Spacing="16">
                <TextBlock Text="外观设置" Style="{StaticResource SubtitleTextBlockStyle}"/>
                
                <StackPanel Spacing="8">
                    <TextBlock Text="应用主题" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                    <RadioButtons x:Name="ThemeRadioButtons" SelectionChanged="ThemeRadioButtons_SelectionChanged">
                        <RadioButton Content="浅色模式 (Light)" Tag="Light"/>
                        <RadioButton Content="深色模式 (Dark)" Tag="Dark"/>
                        <RadioButton Content="跟随系统 (System)" Tag="Default"/>
                    </RadioButtons>
                </StackPanel>

                <StackPanel Spacing="10" Margin="0,8,0,0">
                    <TextBlock Text="预设主题强调色" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button Width="36" Height="36" CornerRadius="18" Background="#0078D4" Tag="#0078D4"
                                Click="AccentColorBtn_Click" ToolTipService.ToolTip="经典蓝" Padding="0" BorderThickness="2" BorderBrush="#80FFFFFF"/>
                        <Button Width="36" Height="36" CornerRadius="18" Background="#6366F1" Tag="#6366F1"
                                Click="AccentColorBtn_Click" ToolTipService.ToolTip="猫爪紫" Padding="0" BorderThickness="2" BorderBrush="#80FFFFFF"/>
                        <Button Width="36" Height="36" CornerRadius="18" Background="#10B981" Tag="#10B981"
                                Click="AccentColorBtn_Click" ToolTipService.ToolTip="翡翠绿" Padding="0" BorderThickness="2" BorderBrush="#80FFFFFF"/>
                        <Button Width="36" Height="36" CornerRadius="18" Background="#F59E0B" Tag="#F59E0B"
                                Click="AccentColorBtn_Click" ToolTipService.ToolTip="琥珀金" Padding="0" BorderThickness="2" BorderBrush="#80FFFFFF"/>
                        <Button Width="36" Height="36" CornerRadius="18" Background="#EF4444" Tag="#EF4444"
                                Click="AccentColorBtn_Click" ToolTipService.ToolTip="珊瑚红" Padding="0" BorderThickness="2" BorderBrush="#80FFFFFF"/>
                        <Button Width="36" Height="36" CornerRadius="18" Background="#EC4899" Tag="#EC4899"
                                Click="AccentColorBtn_Click" ToolTipService.ToolTip="蔷薇粉" Padding="0" BorderThickness="2" BorderBrush="#80FFFFFF"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Spacing="10" Margin="0,8,0,0">
                    <TextBlock Text="自定义强调色" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                    <ColorPicker x:Name="AccentColorPicker" IsColorSpectrumVisible="True"
                                 IsColorChannelTextInputVisible="False"
                                 ColorChanged="AccentColorPicker_ColorChanged"/>
                </StackPanel>
            </StackPanel>

            <MenuFlyoutSeparator/>

            <!-- Section 3: 网盘授权与配置中心 -->
            <StackPanel Spacing="16">
                <TextBlock Text="网盘授权与配置中心" Style="{StaticResource SubtitleTextBlockStyle}"/>
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" Padding="20" CornerRadius="8" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                            <TextBlock Text="内嵌网盘扫码与授权控制台" FontWeight="SemiBold" FontSize="14"/>
                            <TextBlock Text="支持夸克、阿里、百度、UC、115 等网盘的一键手机扫码登录与 4K 高速转存授权。" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <Button Grid.Column="1"
                                Content="🖥️ 打开配置中心"
                                Click="OpenInAppConfigCenter_Click"
                                Style="{StaticResource AccentButtonStyle}"
                                VerticalAlignment="Center"
                                Margin="16,0,0,0"/>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- Section 4: 关于与交流 -->
            <StackPanel Spacing="16">
                <TextBlock Text="关于与社区支持" Style="{StaticResource SubtitleTextBlockStyle}"/>
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" Padding="20" CornerRadius="8" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                    <StackPanel Spacing="14">
                        <StackPanel Spacing="4">
                            <TextBlock Text="CatPawPlayer 猫爪播放器" FontWeight="Bold" FontSize="16"/>
                            <TextBlock x:Name="VersionTextBlock" Text="版本 2.1.3 正式版 (WinUI 3 原生版)" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Text="基于 Windows App SDK / WinUI 3、Yaozhi-MPV 渲染引擎与 Node.js 爬虫引擎原生构建。" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>

                        <!-- Community & Support Buttons -->
                        <Grid ColumnSpacing="10" RowSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Button Grid.Row="0" Grid.Column="0"
                                    HorizontalAlignment="Stretch"
                                    Click="OpenGitHub_Click"
                                    Style="{StaticResource SubtleButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE774;" Foreground="{ThemeResource AccentAAFillColorDefaultBrush}"/>
                                    <TextBlock Text="GitHub 项目主页" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button Grid.Row="0" Grid.Column="1"
                                    HorizontalAlignment="Stretch"
                                    Click="CopyQQ_Click"
                                    Style="{StaticResource SubtleButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE90A;" Foreground="{ThemeResource AccentAAFillColorDefaultBrush}"/>
                                    <TextBlock Text="客服 QQ" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button Grid.Row="1" Grid.Column="0"
                                    HorizontalAlignment="Stretch"
                                    Click="OpenTelegramChannel_Click"
                                    Style="{StaticResource SubtleButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE8BD;" Foreground="{ThemeResource AccentAAFillColorDefaultBrush}"/>
                                    <TextBlock Text="Telegram 官方频道" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button Grid.Row="1" Grid.Column="1"
                                    HorizontalAlignment="Stretch"
                                    Click="OpenTelegramGroup_Click"
                                    Style="{StaticResource SubtleButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE716;" Foreground="{ThemeResource AccentAAFillColorDefaultBrush}"/>
                                    <TextBlock Text="Telegram 交流群组" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <TeachingTip x:Name="QQCopyTip"
                                     Title="复制成功"
                                     Subtitle="客服 QQ 号码（896367449）已成功复制到剪贴板！"
                                     IsLightDismissEnabled="True"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Section 5: 免责声明 -->
            <StackPanel Spacing="12">
                <TextBlock Text="免责声明与版权须知" Style="{StaticResource SubtitleTextBlockStyle}"/>
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" Padding="18,16" CornerRadius="8" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE946;" Foreground="{ThemeResource SystemFillColorCautionBrush}" FontSize="15"/>
                            <TextBlock Text="使用须知与法律声明" FontWeight="SemiBold" FontSize="13.5"/>
                        </StackPanel>
                        <TextBlock Text="1. AinanPlayer 仅为一款基于 WinUI 3 与开源解码内核构建的本地通用音视频播放工具与接口解析客户端，软件本身不提供、不存储、不发布任何音视频内容，亦不架设任何媒体流服务器。"
                                   TextWrapping="Wrap" LineHeight="20" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Text="2. 软件内所有订阅源、站点数据、视频直链及网盘服务均由用户自愿配置或来源于第三方公开网络接口，内容的合法性、真实性与可用性由源服务提供方负责，开发者不对其承担连带法律责任。"
                                   TextWrapping="Wrap" LineHeight="20" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Text="3. 本软件仅供计算机技术研究与个人编程学习使用，严禁用于任何商业盈利、非法传播或侵权行为。请广大用户自觉遵守国家法律法规，尊重原创与知识产权。"
                                   TextWrapping="Wrap" LineHeight="20" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </Border>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>
