<Page
    x:Class="CatPawPlayer.WinUI.Pages.FavoritesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CatPawPlayer.WinUI.Controls"
    xmlns:models="using:CatPawPlayer.WinUI.Models">

    <Grid Padding="24,12,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,0,0,16">
            <TextBlock Text="我的收藏" Style="{StaticResource TitleTextBlockStyle}"/>
            <TextBlock x:Name="CountText" 
                       Style="{StaticResource SubtitleTextBlockStyle}" 
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       VerticalAlignment="Bottom"
                       Margin="0,0,0,4"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="16">
                <GridView x:Name="FavoritesGridView" 
                          HorizontalAlignment="Stretch"
                          SelectionMode="None" 
                          IsItemClickEnabled="True" 
                          ItemClick="FavoritesGridView_ItemClick"
                          SizeChanged="FavoritesGridView_SizeChanged">
                    <GridView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </GridView.ItemsPanel>
                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="models:VodItem">
                            <controls:MediaCard Item="{x:Bind}" Margin="4"/>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>

                <!-- Empty State -->
                <StackPanel x:Name="EmptyStatePanel" 
                            HorizontalAlignment="Center" 
                            VerticalAlignment="Center" 
                            Visibility="Collapsed"
                            Margin="0,64,0,0"
                            Spacing="12">
                    <FontIcon Glyph="&#xE734;" FontSize="48" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Text="暂无收藏影片" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center"/>
                    <TextBlock Text="去全量分类或首页推荐中浏览并点击收藏吧" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
