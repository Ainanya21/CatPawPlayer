<Page
    x:Class="CatPawPlayer.WinUI.Pages.PlayerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="Black">
        <!-- Loading overlay -->
        <StackPanel x:Name="LoadingPanel"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Spacing="14">
            <ProgressRing IsActive="True" Width="48" Height="48" Foreground="White"/>
            <TextBlock Text="正在解析视频流与真实元数据..." Foreground="White" HorizontalAlignment="Center"/>
            <TextBlock x:Name="ProbingMetaText" Foreground="#88FFFFFF" FontSize="12" HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- WebView2 container (added in code) -->
        <Grid x:Name="WebViewContainer" Visibility="Collapsed"/>

        <!-- Top control & Metadata HUD bar -->
        <Grid x:Name="TopBar"
              VerticalAlignment="Top"
              Background="#CC111827"
              Padding="16,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Click="BackBtn_Click"
                    Style="{StaticResource SubtleButtonStyle}"
                    Foreground="White">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE72B;" Foreground="White"/>
                    <TextBlock Text="返回" Foreground="White"/>
                </StackPanel>
            </Button>

            <!-- Video Title & Real Metadata Badges -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,16,0" Spacing="4">
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText" Foreground="White"
                               Style="{StaticResource BodyStrongTextBlockStyle}"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="EpText" Foreground="#AAFFFFFF"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Stream Metadata Badges -->
                <StackPanel x:Name="MetadataBadgePanel" Orientation="Horizontal" Spacing="6" Visibility="Collapsed">
                    <!-- Resolution Badge -->
                    <Border x:Name="ResBadge"
                            Background="{ThemeResource SystemAccentColor}"
                            CornerRadius="4" Padding="6,2">
                        <TextBlock x:Name="ResBadgeText" Text="1080P" FontSize="11" FontWeight="Bold" Foreground="White"/>
                    </Border>

                    <!-- Codec Badge -->
                    <Border Background="#33FFFFFF" CornerRadius="4" Padding="6,2">
                        <TextBlock x:Name="CodecBadgeText" Text="HEVC / H.265" FontSize="11" Foreground="#DDFFFFFF"/>
                    </Border>

                    <!-- FPS Badge -->
                    <Border Background="#33FFFFFF" CornerRadius="4" Padding="6,2">
                        <TextBlock x:Name="FpsBadgeText" Text="60 FPS" FontSize="11" Foreground="#DDFFFFFF"/>
                    </Border>

                    <!-- Audio Badge -->
                    <Border Background="#33FFFFFF" CornerRadius="4" Padding="6,2">
                        <TextBlock x:Name="AudioBadgeText" Text="AAC 高清音频" FontSize="11" Foreground="#DDFFFFFF"/>
                    </Border>

                    <!-- HDR Badge (if present) -->
                    <Border x:Name="HdrBadge"
                            Background="#D97706"
                            CornerRadius="4" Padding="6,2"
                            Visibility="Collapsed">
                        <TextBlock Text="HDR10" FontSize="11" FontWeight="Bold" Foreground="White"/>
                    </Border>

                    <!-- Latency Ping Badge -->
                    <Border x:Name="LatencyBadge"
                            Background="#059669"
                            CornerRadius="4" Padding="6,2"
                            Visibility="Collapsed">
                        <TextBlock x:Name="LatencyBadgeText" Text="35ms 极速" FontSize="11" FontWeight="SemiBold" Foreground="White"/>
                    </Border>
                </StackPanel>
            </StackPanel>

            <!-- Actions & Quality Selector -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <!-- Quality Track Selector (for multi-stream playlists) -->
                <ComboBox x:Name="QualitySelector"
                          Visibility="Collapsed"
                          SelectionChanged="QualitySelector_SelectionChanged"
                          MinWidth="120"
                          PlaceholderText="清晰度"/>

                <Button Click="OpenInMpvBtn_Click"
                        Style="{StaticResource AccentButtonStyle}"
                        ToolTipService.ToolTip="在 Yaozhi-MPV 硬件加速播放器中打开此视频">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE768;" FontSize="12"/>
                        <TextBlock Text="🚀 在 MPV 中播放"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Error Bar -->
        <InfoBar x:Name="ErrorBar"
                 VerticalAlignment="Bottom"
                 IsOpen="False"
                 IsClosable="True"
                 Severity="Error"/>
    </Grid>
</Page>
