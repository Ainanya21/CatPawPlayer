<Page
    x:Class="CatPawPlayer.WinUI.Pages.SearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CatPawPlayer.WinUI.Controls"
    xmlns:models="using:CatPawPlayer.WinUI.Models">

    <Grid Padding="24,16,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Search Input & History -->
        <StackPanel Grid.Row="0" Spacing="10" Margin="0,0,0,16">
            <TextBlock Text="聚合搜索" Style="{StaticResource TitleTextBlockStyle}"/>

            <AutoSuggestBox x:Name="SearchBox"
                            QuerySubmitted="SearchBox_QuerySubmitted"
                            TextChanged="SearchBox_TextChanged"
                            SuggestionChosen="SearchBox_SuggestionChosen"
                            PlaceholderText="输入片名、演员或导演，将在多源同时搜索..."
                            MaxWidth="650"
                            HorizontalAlignment="Left"/>

            <!-- Search History Panel -->
            <StackPanel x:Name="HistoryContainer" Spacing="8" Margin="0,4,0,0" Visibility="Collapsed">
                <Grid MaxWidth="650" HorizontalAlignment="Left" Width="650">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE81C;" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Text="搜索历史" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontWeight="SemiBold"/>
                    </StackPanel>

                    <Button x:Name="ClearHistoryBtn"
                            HorizontalAlignment="Right"
                            Click="ClearHistoryBtn_Click"
                            Style="{StaticResource SubtleButtonStyle}"
                            Padding="6,2"
                            ToolTipService.ToolTip="清空搜索历史">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <FontIcon Glyph="&#xE74D;" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                            <TextBlock Text="清空" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- History Pills Horizontal Wrap Panel -->
                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled"
                              HorizontalScrollMode="Enabled"
                              MaxWidth="650"
                              HorizontalAlignment="Left">
                    <StackPanel x:Name="HistoryPillsPanel"
                                Orientation="Horizontal"
                                Spacing="8"
                                Padding="0,2"/>
                </ScrollViewer>
            </StackPanel>
        </StackPanel>

        <!-- Loading -->
        <ProgressRing x:Name="LoadingRing" Grid.Row="1" IsActive="False" Width="48" Height="48"
                      HorizontalAlignment="Center" VerticalAlignment="Center"/>

        <!-- Results (Vertical Scroll Only) -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="SearchResultsControl">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:AggregateSearchResult">
                        <Expander Header="{x:Bind SiteName}" IsExpanded="True" HorizontalAlignment="Stretch" Margin="0,0,0,14">
                            <Grid Margin="0,4,0,4">
                                <!-- Horizontal ScrollViewer with mouse wheel scroll disabled so wheel scrolls outer page -->
                                <ScrollViewer x:Name="RowScroller"
                                              HorizontalScrollBarVisibility="Hidden"
                                              VerticalScrollBarVisibility="Disabled"
                                              HorizontalScrollMode="Disabled"
                                              VerticalScrollMode="Disabled">
                                    <ItemsRepeater ItemsSource="{x:Bind List}">
                                        <ItemsRepeater.Layout>
                                            <StackLayout Orientation="Horizontal" Spacing="12"/>
                                        </ItemsRepeater.Layout>
                                        <ItemsRepeater.ItemTemplate>
                                            <DataTemplate x:DataType="models:VodItem">
                                                <controls:MediaCard Item="{x:Bind}" Width="140"/>
                                            </DataTemplate>
                                        </ItemsRepeater.ItemTemplate>
                                    </ItemsRepeater>
                                </ScrollViewer>

                                <!-- Left Scroll Button (Floating Overlay) -->
                                <Button Click="LeftScrollBtn_Click"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Margin="4,0,0,0"
                                        Width="38" Height="38"
                                        CornerRadius="19"
                                        Background="#D018181B"
                                        BorderBrush="#33FFFFFF"
                                        BorderThickness="1"
                                        Foreground="White"
                                        ToolTipService.ToolTip="向左查看更多">
                                    <FontIcon Glyph="&#xE76B;" FontSize="13" Foreground="White"/>
                                </Button>

                                <!-- Right Scroll Button (Floating Overlay) -->
                                <Button Click="RightScrollBtn_Click"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Margin="0,0,4,0"
                                        Width="38" Height="38"
                                        CornerRadius="19"
                                        Background="#D018181B"
                                        BorderBrush="#33FFFFFF"
                                        BorderThickness="1"
                                        Foreground="White"
                                        ToolTipService.ToolTip="向右查看更多">
                                    <FontIcon Glyph="&#xE76C;" FontSize="13" Foreground="White"/>
                                </Button>
                            </Grid>
                        </Expander>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Empty / Prompt -->
        <StackPanel x:Name="EmptyStatePanel" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
            <FontIcon Glyph="&#xE721;" FontSize="48" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center"/>
            <TextBlock x:Name="EmptyStateText" Text="输入关键词开始全网多源聚合搜索" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center"/>
        </StackPanel>
    </Grid>
</Page>
