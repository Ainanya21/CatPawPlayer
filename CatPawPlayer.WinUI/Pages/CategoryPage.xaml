<Page
    x:Class="CatPawPlayer.WinUI.Pages.CategoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CatPawPlayer.WinUI.Controls"
    xmlns:models="using:CatPawPlayer.WinUI.Models">

    <Grid RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header & Top Category Tabs -->
        <StackPanel Grid.Row="0" Padding="24,12,24,8" Spacing="10">
            <Grid>
                <StackPanel Spacing="4">
                    <TextBlock Text="全量分类" Style="{StaticResource TitleTextBlockStyle}"/>
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="当前影视源："
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   VerticalAlignment="Center"/>
                        <ComboBox x:Name="SiteSelector"
                                  SelectionChanged="SiteSelector_SelectionChanged"
                                  MinWidth="200"/>
                    </StackPanel>
                </StackPanel>
                <Button HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Click="RefreshBtn_Click"
                        Style="{StaticResource SubtleButtonStyle}"
                        ToolTipService.ToolTip="刷新分类">
                    <FontIcon Glyph="&#xE72C;"/>
                </Button>
            </Grid>

            <!-- Level 1 Category Tabs with Filter Toggle Button -->
            <Grid x:Name="CategoryTabsRow">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <ScrollViewer Grid.Column="0"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled"
                              HorizontalScrollMode="Enabled">
                    <StackPanel x:Name="CategoryPanel"
                                Orientation="Horizontal"
                                Spacing="8"
                                Padding="0,4"/>
                </ScrollViewer>

                <Button x:Name="FilterToggleBtn"
                        Grid.Column="1"
                        Margin="12,0,0,0"
                        Click="FilterToggleBtn_Click"
                        Style="{StaticResource SubtleButtonStyle}"
                        Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE71C;" FontSize="12"/>
                        <TextBlock x:Name="FilterToggleText" Text="收起筛选 ▴" FontSize="12"/>
                    </StackPanel>
                </Button>
            </Grid>
        </StackPanel>

        <!-- Loading -->
        <ProgressBar x:Name="LoadingBar" Grid.Row="1" IsIndeterminate="True" Visibility="Collapsed"/>

        <!-- Main View Area (Row 2) -->
        <Grid Grid.Row="2">

            <!-- 1. Video Items Scroller (Used for standard media sites) -->
            <ScrollViewer x:Name="VideosScrollViewer" Padding="24,8,24,24">
                <StackPanel Spacing="16">

                    <!-- Level 2+ Multi-Tier Filter Rows -->
                    <Border x:Name="FilterGroupsContainer"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16,10"
                            Visibility="Collapsed">
                        <StackPanel x:Name="FilterGroupsPanel" Spacing="8"/>
                    </Border>

                    <!-- Media Items Grid (Edge-Aligned) -->
                    <GridView x:Name="ItemsGrid"
                              HorizontalAlignment="Stretch"
                              SelectionMode="None"
                              IsItemClickEnabled="True"
                              ItemClick="ItemsGrid_ItemClick"
                              SizeChanged="ItemsGrid_SizeChanged">
                        <GridView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsWrapGrid Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </GridView.ItemsPanel>
                        <GridView.ItemTemplate>
                            <DataTemplate x:DataType="models:VodItem">
                                <controls:MediaCard Item="{x:Bind}" Margin="4"/>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>

                    <!-- Pagination -->
                    <StackPanel x:Name="PaginationPanel"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Spacing="8"
                                Visibility="Collapsed">
                        <Button x:Name="PrevBtn" Content="上一页" Click="PrevBtn_Click" IsEnabled="False"/>
                        <TextBlock x:Name="PageText" VerticalAlignment="Center"/>
                        <Button x:Name="NextBtn" Content="下一页" Click="NextBtn_Click"/>
                    </StackPanel>

                    <!-- Empty State -->
                    <StackPanel x:Name="EmptyPanel" Visibility="Collapsed"
                                HorizontalAlignment="Center" Spacing="12" Padding="40">
                        <FontIcon Glyph="&#xE8F1;" FontSize="48"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                  HorizontalAlignment="Center"/>
                        <TextBlock Text="此分类暂无内容" Style="{StaticResource SubtitleTextBlockStyle}"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- 2. In-App Embedded Config Center Web View (Direct stretch, independent scroll) -->
            <Border x:Name="ConfigCenterInAppView"
                    Margin="24,4,24,16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="0"
                    VerticalAlignment="Stretch"
                    HorizontalAlignment="Stretch"
                    Visibility="Collapsed">
                <Grid RowSpacing="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Action Header (Clean, without overlapping subtitle) -->
                    <Border Grid.Row="0"
                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                            Padding="16,10"
                            CornerRadius="10,10,0,0"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="0,0,0,1">
                        <Grid>
                            <TextBlock Text="🛠️ 配置中心（网盘授权、服务管理与热更新）"
                                       FontWeight="Bold"
                                       FontSize="14"
                                       VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                <Button Content="🔄 刷新页面" Click="ReloadConfigCenter_Click" Style="{StaticResource SubtleButtonStyle}"/>
                                <Button Content="🌐 在外部浏览器中打开" Click="OpenExternalConfigCenter_Click" Style="{StaticResource SubtleButtonStyle}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Full-Height In-App WebView2 Container with native wheel scrolling -->
                    <Grid x:Name="ConfigCenterWebViewContainer"
                          Grid.Row="1"
                          VerticalAlignment="Stretch"
                          HorizontalAlignment="Stretch">
                    </Grid>
                </Grid>
            </Border>

        </Grid>
    </Grid>
</Page>
