<Page
    x:Class="CatPawPlayer.WinUI.Pages.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:CatPawPlayer.WinUI.Models">

    <Grid Padding="24,16,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="观看历史" Style="{StaticResource TitleTextBlockStyle}" VerticalAlignment="Center"/>
            <Button Content="清空历史" Click="ClearAll_Click" HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </Grid>

        <ListView x:Name="HistoryListView" 
                  Grid.Row="1" 
                  IsItemClickEnabled="True" 
                  ItemClick="HistoryListView_ItemClick">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:HistoryItem">
                    <Grid Margin="0,8" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" CornerRadius="6" Width="60" Height="90">
                            <Image Source="{x:Bind VodPic}" Stretch="UniformToFill"/>
                        </Border>
                        
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                            <TextBlock Text="{x:Bind VodName}" FontWeight="SemiBold" FontSize="15" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{x:Bind EpName}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="13"/>
                            <TextBlock Text="{x:Bind SiteName}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" FontSize="12"/>
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ProgressBar Value="{x:Bind ProgressPercent}" Maximum="100" VerticalAlignment="Center" Grid.Column="0" Margin="0,0,16,0"/>
                                <TextBlock Text="{x:Bind ProgressText}" Grid.Column="1" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"/>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <StackPanel x:Name="EmptyStatePanel" 
                    Grid.Row="1" 
                    HorizontalAlignment="Center" 
                    VerticalAlignment="Center" 
                    Visibility="Collapsed"
                    Spacing="12">
            <FontIcon Glyph="&#xE81C;" FontSize="48" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <TextBlock Text="暂无观看历史" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="15"/>
        </StackPanel>
    </Grid>
</Page>
