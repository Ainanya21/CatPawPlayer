<Page
    x:Class="CatPawPlayer.WinUI.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:CatPawPlayer.WinUI.Models"
    xmlns:controls="using:CatPawPlayer.WinUI.Controls">

    <Grid>
        <!-- Loading Overlay -->
        <ProgressRing x:Name="LoadingRing"
                      IsActive="True"
                      Width="48" Height="48"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"/>

        <ScrollViewer x:Name="ContentScroller"
                      Visibility="Collapsed"
                      Padding="24,12,24,32">
            <StackPanel Spacing="24">

                <!-- Source Selector Header -->
                <Grid>
                    <StackPanel Spacing="4">
                        <TextBlock Text="首页推荐" Style="{StaticResource TitleTextBlockStyle}"/>
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="当前影视源："
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       VerticalAlignment="Center"/>
                            <ComboBox x:Name="SiteSelector"
                                      SelectionChanged="SiteSelector_SelectionChanged"
                                      MinWidth="200"
                                      PlaceholderText="选择影视源..."/>
                        </StackPanel>
                    </StackPanel>
                    <Button HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Click="RefreshBtn_Click"
                            Style="{StaticResource SubtleButtonStyle}"
                            ToolTipService.ToolTip="刷新首页数据">
                        <FontIcon Glyph="&#xE72C;"/>
                    </Button>
                </Grid>

                <!-- High-Definition Hero Banner (Crisp Split Ambient Art Design) -->
                <Grid x:Name="BannerContainer"
                      Height="300"
                      CornerRadius="12"
                      Visibility="Collapsed">

                    <!-- Ambient Blurred Background Layer -->
                    <Border CornerRadius="12">
                        <Grid>
                            <Image x:Name="HeroBgImage"
                                   Stretch="UniformToFill"
                                   Opacity="0.25"
                                   HorizontalAlignment="Center"/>
                            <Rectangle>
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#F0111827" Offset="0"/>
                                        <GradientStop Color="#D0111827" Offset="0.5"/>
                                        <GradientStop Color="#B0111827" Offset="1"/>
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                        </Grid>
                    </Border>

                    <!-- Foreground Content Area (Animated on transition) -->
                    <Grid x:Name="HeroContentArea" Margin="48,20,48,20" ColumnSpacing="28">
                        <Grid.RenderTransform>
                            <TranslateTransform x:Name="HeroTranslate"/>
                        </Grid.RenderTransform>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left Info Column -->
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="10">
                            <!-- Badges -->
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Border x:Name="HeroBadge"
                                        Background="{ThemeResource SystemAccentColor}"
                                        Padding="8,3"
                                        CornerRadius="4"
                                        Visibility="Collapsed">
                                    <TextBlock x:Name="HeroBadgeText"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="White"/>
                                </Border>
                                <Border Background="#33FFFFFF"
                                        Padding="8,3"
                                        CornerRadius="4">
                                    <TextBlock Text="精选推荐"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="#DDFFFFFF"/>
                                </Border>
                            </StackPanel>

                            <!-- Title -->
                            <TextBlock x:Name="HeroTitle"
                                       Style="{StaticResource TitleTextBlockStyle}"
                                       FontSize="26"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       MaxLines="1"
                                       TextTrimming="CharacterEllipsis"/>

                            <!-- Remarks / SubText -->
                            <TextBlock x:Name="HeroSubText"
                                       Foreground="#BBFFFFFF"
                                       FontSize="13"
                                       MaxLines="3"
                                       TextWrapping="Wrap"
                                       TextTrimming="CharacterEllipsis"/>

                            <!-- Action Buttons -->
                            <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,8,0,0">
                                <Button Content="▶ 立即播放"
                                        Style="{StaticResource AccentButtonStyle}"
                                        Padding="18,8"
                                        Click="HeroPlayBtn_Click"/>
                                <Button Content="查看详情"
                                        Padding="16,8"
                                        Click="HeroDetailBtn_Click"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Right Sharp HD Poster Column -->
                        <Border Grid.Column="1"
                                Width="170"
                                Height="240"
                                CornerRadius="8"
                                BorderThickness="1"
                                BorderBrush="#40FFFFFF"
                                VerticalAlignment="Center">
                            <Image x:Name="HeroPosterImage"
                                   Stretch="UniformToFill"
                                   HorizontalAlignment="Center"/>
                        </Border>
                    </Grid>

                    <!-- Circular Previous / Next Navigation Arrows Only -->
                    <Button Width="36" Height="36" CornerRadius="18"
                            HorizontalAlignment="Left" VerticalAlignment="Center"
                            Margin="8,0,0,0"
                            Click="PrevBanner_Click"
                            Style="{StaticResource SubtleButtonStyle}"
                            Background="#80000000"
                            BorderThickness="1"
                            BorderBrush="#40FFFFFF"
                            ToolTipService.ToolTip="上一张">
                        <FontIcon Glyph="&#xE76B;" FontSize="13" Foreground="White"/>
                    </Button>
                    <Button Width="36" Height="36" CornerRadius="18"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            Margin="0,0,8,0"
                            Click="NextBanner_Click"
                            Style="{StaticResource SubtleButtonStyle}"
                            Background="#80000000"
                            BorderThickness="1"
                            BorderBrush="#40FFFFFF"
                            ToolTipService.ToolTip="下一张">
                        <FontIcon Glyph="&#xE76C;" FontSize="13" Foreground="White"/>
                    </Button>
                </Grid>

                <!-- Showcase Grid (Edge-Aligned with Top Banner) -->
                <StackPanel x:Name="ShowcasePanel" Spacing="12">
                    <TextBlock x:Name="ShowcaseTitle"
                               Text="⚡ 最新推荐"
                               Style="{StaticResource SubtitleTextBlockStyle}"/>

                    <GridView x:Name="ShowcaseGrid"
                              HorizontalAlignment="Stretch"
                              SelectionMode="None"
                              IsItemClickEnabled="False"
                              SizeChanged="ShowcaseGrid_SizeChanged">
                        <GridView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsWrapGrid Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </GridView.ItemsPanel>
                        <GridView.ItemTemplate>
                            <DataTemplate x:DataType="models:VodItem">
                                <controls:MediaCard Item="{x:Bind}" Margin="4"/>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>
                </StackPanel>

                <!-- Empty State -->
                <StackPanel x:Name="EmptyPanel"
                            HorizontalAlignment="Center"
                            Spacing="12"
                            Margin="0,48,0,0"
                            Visibility="Collapsed">
                    <FontIcon Glyph="&#xE7BA;" FontSize="48"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Text="暂无推荐内容，请切换影视源或更新订阅"
                               Style="{StaticResource SubtitleTextBlockStyle}"
                               HorizontalAlignment="Center"/>
                    <Button Content="管理订阅源"
                            HorizontalAlignment="Center"
                            Click="GoToSubscription_Click"
                            Style="{StaticResource AccentButtonStyle}"/>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
