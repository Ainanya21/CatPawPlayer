<Window
    x:Class="CatPawPlayer.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="猫爪播放器">

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Custom App TitleBar area -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Margin="16,0,140,0" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE7F4;" FontSize="13" Foreground="{ThemeResource AccentAAFillColorDefaultBrush}"/>
                <TextBlock Text="猫爪播放器" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- Navigation View in Row 1 -->
        <NavigationView
            x:Name="NavView"
            Grid.Row="1"
            CompactModeThresholdWidth="0"
            ExpandedModeThresholdWidth="800"
            PaneDisplayMode="Auto"
            IsPaneToggleButtonVisible="True"
            SelectionChanged="NavView_SelectionChanged"
            IsBackButtonVisible="Collapsed"
            OpenPaneLength="220"
            CompactPaneLength="48">

            <!-- Navigation Items -->
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="NavSubscription" Tag="subscription" Content="订阅管理">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE728;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavHome" Tag="home" Content="首页推荐">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavCategory" Tag="category" Content="全量分类">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7B3;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavSearch" Tag="search" Content="聚合搜索">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE721;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavHistory" Tag="history" Content="观看历史">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE81C;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavFavorites" Tag="favorites" Content="我的收藏">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE734;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <!-- Page Frame -->
            <Frame x:Name="ContentFrame" Margin="0"/>
        </NavigationView>
    </Grid>
</Window>
