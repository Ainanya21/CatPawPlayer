<UserControl
    x:Class="CatPawPlayer.WinUI.Controls.MediaCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Button x:Name="CardBtn"
                Padding="0"
                CornerRadius="8"
                Click="CardBtn_Click"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch"
                Background="Transparent"
                BorderBrush="Transparent"
                BorderThickness="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Cover Image (Responsive height filling card) -->
                <Border Grid.Row="0" CornerRadius="8,8,0,0">
                    <Grid>
                        <Image x:Name="CoverImage"
                               Stretch="UniformToFill"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>

                        <!-- Badge -->
                        <Border x:Name="BadgeBorder"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Margin="0,6,6,0"
                                Background="{ThemeResource SystemFillColorAttentionBackgroundBrush}"
                                CornerRadius="4"
                                Padding="5,1">
                            <TextBlock x:Name="BadgeText"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource SystemFillColorAttentionBrush}"/>
                        </Border>

                        <!-- Play Overlay on Hover -->
                        <Border x:Name="PlayOverlay"
                                Background="#66000000"
                                Visibility="Collapsed"
                                CornerRadius="8,8,0,0">
                            <FontIcon Glyph="&#xE768;"
                                      FontSize="32"
                                      Foreground="White"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- Title Area -->
                <StackPanel Grid.Row="1" Padding="8,6,8,8" Spacing="2">
                    <TextBlock x:Name="TitleText"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"
                               MaxLines="2"
                               TextWrapping="Wrap"/>
                    <TextBlock x:Name="SubText"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Grid>
        </Button>
    </Grid>
</UserControl>
